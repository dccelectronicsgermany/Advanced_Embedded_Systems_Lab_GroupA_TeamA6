[
  {
    "id": "tab_flow03",
    "type": "tab",
    "label": "Flow 03 – History Charts",
    "disabled": false,
    "info": "Step 3: Adds temperature and knock history charts to the dashboard. Builds on Flow 02."
  },
  {
    "id": "mqtt_in_03",
    "type": "mqtt in",
    "z": "tab_flow03",
    "name": "MQTT In",
    "topic": "sensors/node01",
    "qos": "0",
    "datatype": "utf8",
    "broker": "mqtt_broker_03",
    "x": 120,
    "y": 160,
    "wires": [["fn_parse_03"]]
  },
  {
    "id": "fn_parse_03",
    "type": "function",
    "z": "tab_flow03",
    "name": "Parse Packet",
    "func": "var parts = msg.payload.split(';');\nvar obj = {};\nparts.forEach(function(p) {\n  var kv = p.split(':');\n  if (kv.length === 2) obj[kv[0].toLowerCase()] = kv[1];\n});\nmsg.temp   = parseFloat(obj.temp)  || 0;\nmsg.knock  = parseInt(obj.knock)   || 0;\nmsg.status = obj.status            || 'UNKNOWN';\nreturn msg;",
    "outputs": 1,
    "x": 310,
    "y": 160,
    "wires": [["gauge_temp_03", "txt_status_03", "txt_knock_03", "fn_temp_chart_03", "fn_knock_chart_03"]]
  },
  {
    "id": "gauge_temp_03",
    "type": "ui_gauge",
    "z": "tab_flow03",
    "name": "Temperature",
    "group": "grp_sensor_03",
    "order": 1,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Temperature",
    "label": "°C",
    "format": "{{value}}°C",
    "min": "15",
    "max": "40",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "25",
    "seg2": "30",
    "x": 530,
    "y": 80,
    "wires": []
  },
  {
    "id": "txt_status_03",
    "type": "ui_text",
    "z": "tab_flow03",
    "name": "Alert Status",
    "group": "grp_sensor_03",
    "order": 2,
    "width": 6,
    "height": 2,
    "format": "<span style='font-size:22px;font-weight:bold'>{{msg.status}}</span>",
    "label": "Status",
    "x": 530,
    "y": 140,
    "wires": []
  },
  {
    "id": "txt_knock_03",
    "type": "ui_text",
    "z": "tab_flow03",
    "name": "Knock Count",
    "group": "grp_sensor_03",
    "order": 3,
    "width": 6,
    "height": 2,
    "format": "<span style='font-size:22px'>{{msg.knock}}</span>",
    "label": "Knock Count",
    "x": 530,
    "y": 200,
    "wires": []
  },
  {
    "id": "fn_temp_chart_03",
    "type": "function",
    "z": "tab_flow03",
    "name": "Prep Temp Chart",
    "func": "msg.payload = msg.temp;\nmsg.topic   = \"Temperature (°C)\";\nmsg.x       = Date.now();\nreturn msg;",
    "outputs": 1,
    "x": 530,
    "y": 300,
    "wires": [["chart_temp_03"]]
  },
  {
    "id": "chart_temp_03",
    "type": "ui_chart",
    "z": "tab_flow03",
    "name": "Temp History",
    "group": "grp_charts_03",
    "order": 1,
    "width": 12,
    "height": 6,
    "label": "Temperature History",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Waiting for data...",
    "dot": false,
    "ymin": "15",
    "ymax": "40",
    "removeOlder": "5",
    "removeOlderUnit": "60",
    "cutout": 0,
    "x": 760,
    "y": 300,
    "wires": [[], []]
  },
  {
    "id": "fn_knock_chart_03",
    "type": "function",
    "z": "tab_flow03",
    "name": "Prep Knock Chart",
    "func": "msg.payload = msg.knock;\nmsg.topic   = \"Knock Count\";\nmsg.x       = Date.now();\nreturn msg;",
    "outputs": 1,
    "x": 530,
    "y": 400,
    "wires": [["chart_knock_03"]]
  },
  {
    "id": "chart_knock_03",
    "type": "ui_chart",
    "z": "tab_flow03",
    "name": "Knock History",
    "group": "grp_charts_03",
    "order": 2,
    "width": 12,
    "height": 4,
    "label": "Knock History",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "step-after",
    "nodata": "Waiting for data...",
    "dot": true,
    "ymin": "0",
    "ymax": "10",
    "removeOlder": "5",
    "removeOlderUnit": "60",
    "cutout": 0,
    "x": 760,
    "y": 400,
    "wires": [[], []]
  },
  {
    "id": "grp_sensor_03",
    "type": "ui_group",
    "name": "Sensor Data",
    "tab": "ui_tab_03",
    "order": 1,
    "disp": true,
    "width": "6"
  },
  {
    "id": "grp_charts_03",
    "type": "ui_group",
    "name": "History",
    "tab": "ui_tab_03",
    "order": 2,
    "disp": true,
    "width": "12"
  },
  {
    "id": "ui_tab_03",
    "type": "ui_tab",
    "name": "Sensor Monitor",
    "icon": "dashboard",
    "order": 1,
    "disabled": false,
    "hidden": false
  },
  {
    "id": "mqtt_broker_03",
    "type": "mqtt-broker",
    "name": "Local Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "nodered_flow03",
    "usetls": false,
    "compatmode": false,
    "keepalive": "60",
    "cleansession": true
  }
]
