[
  {
    "id": "tab_flow05",
    "type": "tab",
    "label": "Flow 05 – Alert Logging",
    "disabled": false,
    "info": "Extension flow: logs WARNING and CRITICAL events to a local file on the Raspberry Pi with timestamps. Requires node-red-contrib-fs-ops or the built-in file node."
  },
  {
    "id": "mqtt_in_05",
    "type": "mqtt in",
    "z": "tab_flow05",
    "name": "MQTT In",
    "topic": "sensors/node01",
    "qos": "0",
    "datatype": "utf8",
    "broker": "mqtt_broker_05",
    "x": 120,
    "y": 160,
    "wires": [["fn_parse_05"]]
  },
  {
    "id": "fn_parse_05",
    "type": "function",
    "z": "tab_flow05",
    "name": "Parse Packet",
    "func": "var parts = msg.payload.split(';');\nvar obj = {};\nparts.forEach(function(p) {\n  var kv = p.split(':');\n  if (kv.length === 2) obj[kv[0].toLowerCase()] = kv[1];\n});\nmsg.temp   = parseFloat(obj.temp)  || 0;\nmsg.knock  = parseInt(obj.knock)   || 0;\nmsg.status = obj.status            || 'UNKNOWN';\nreturn msg;",
    "outputs": 1,
    "x": 310,
    "y": 160,
    "wires": [["fn_filter_alert_05"]]
  },
  {
    "id": "fn_filter_alert_05",
    "type": "function",
    "z": "tab_flow05",
    "name": "Filter Alerts Only",
    "func": "if (msg.status !== 'WARNING' && msg.status !== 'CRITICAL') return null;\n\nvar lastStatus = flow.get('lastLoggedStatus') || '';\nvar lastTime   = flow.get('lastLoggedTime')   || 0;\nvar now        = Date.now();\n\nif (msg.status === lastStatus && now - lastTime < 30000) return null;\n\nflow.set('lastLoggedStatus', msg.status);\nflow.set('lastLoggedTime', now);\n\nvar ts = new Date().toISOString();\nmsg.payload = ts + '  ' + msg.status + '  TEMP:' + msg.temp.toFixed(1) + '  KNOCK:' + msg.knock + '\\n';\nreturn msg;",
    "outputs": 1,
    "x": 530,
    "y": 160,
    "wires": [["file_log_05", "txt_log_05", "debug_log_05"]]
  },
  {
    "id": "file_log_05",
    "type": "file",
    "z": "tab_flow05",
    "name": "Write to Log File",
    "filename": "/home/pi/sensor_alerts.log",
    "appendNewline": false,
    "createDir": false,
    "overwriteFile": "false",
    "encoding": "utf8",
    "x": 780,
    "y": 120,
    "wires": []
  },
  {
    "id": "debug_log_05",
    "type": "debug",
    "z": "tab_flow05",
    "name": "Log Debug",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "x": 780,
    "y": 200,
    "wires": []
  },
  {
    "id": "txt_log_05",
    "type": "ui_text",
    "z": "tab_flow05",
    "name": "Last Logged Alert",
    "group": "grp_log_05",
    "order": 1,
    "width": 12,
    "height": 2,
    "format": "<code>{{msg.payload}}</code>",
    "label": "Last Logged Alert",
    "x": 780,
    "y": 160,
    "wires": []
  },
  {
    "id": "inject_read_05",
    "type": "inject",
    "z": "tab_flow05",
    "name": "Read Log (every 60s)",
    "props": [{"p": "payload"}],
    "repeat": "60",
    "crontab": "",
    "once": true,
    "onceDelay": 2,
    "topic": "",
    "payload": "/home/pi/sensor_alerts.log",
    "payloadType": "str",
    "x": 160,
    "y": 300,
    "wires": [["file_read_05"]]
  },
  {
    "id": "file_read_05",
    "type": "file in",
    "z": "tab_flow05",
    "name": "Read Log File",
    "filename": "/home/pi/sensor_alerts.log",
    "format": "utf8",
    "chunk": false,
    "sendError": false,
    "encoding": "utf8",
    "x": 390,
    "y": 300,
    "wires": [["txt_full_log_05"]]
  },
  {
    "id": "txt_full_log_05",
    "type": "ui_text",
    "z": "tab_flow05",
    "name": "Full Log",
    "group": "grp_log_05",
    "order": 2,
    "width": 12,
    "height": 6,
    "format": "<pre style='font-size:12px;white-space:pre-wrap;word-break:break-all'>{{msg.payload}}</pre>",
    "label": "Alert Log",
    "x": 580,
    "y": 300,
    "wires": []
  },
  {
    "id": "grp_log_05",
    "type": "ui_group",
    "name": "Alert Log",
    "tab": "ui_tab_05",
    "order": 1,
    "disp": true,
    "width": "12"
  },
  {
    "id": "ui_tab_05",
    "type": "ui_tab",
    "name": "Alert Log",
    "icon": "history",
    "order": 2,
    "disabled": false,
    "hidden": false
  },
  {
    "id": "mqtt_broker_05",
    "type": "mqtt-broker",
    "name": "Local Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "nodered_flow05",
    "usetls": false,
    "compatmode": false,
    "keepalive": "60",
    "cleansession": true
  }
]
