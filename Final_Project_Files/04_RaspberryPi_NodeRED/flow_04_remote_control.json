[
  {
    "id": "tab_flow04",
    "type": "tab",
    "label": "Flow 04 – Remote Control",
    "disabled": false,
    "info": "Step 4: Full dashboard with remote control. Adds threshold sliders, mute toggle, test alert buttons, and last alert timestamp. Publishes commands back to ESP32 via MQTT."
  },
  {
    "id": "mqtt_in_04",
    "type": "mqtt in",
    "z": "tab_flow04",
    "name": "MQTT In",
    "topic": "sensors/node01",
    "qos": "0",
    "datatype": "utf8",
    "broker": "mqtt_broker_04",
    "x": 120,
    "y": 160,
    "wires": [["fn_parse_04"]]
  },
  {
    "id": "fn_parse_04",
    "type": "function",
    "z": "tab_flow04",
    "name": "Parse Packet",
    "func": "var parts = msg.payload.split(';');\nvar obj = {};\nparts.forEach(function(p) {\n  var kv = p.split(':');\n  if (kv.length === 2) obj[kv[0].toLowerCase()] = kv[1];\n});\nmsg.temp   = parseFloat(obj.temp)  || 0;\nmsg.knock  = parseInt(obj.knock)   || 0;\nmsg.status = obj.status            || 'UNKNOWN';\nmsg.mute   = obj.mute === '1';\nmsg.warn   = parseFloat(obj.warn)  || 25;\nmsg.crit   = parseFloat(obj.crit)  || 30;\nreturn msg;",
    "outputs": 1,
    "x": 310,
    "y": 160,
    "wires": [["gauge_temp_04", "txt_status_04", "txt_knock_04", "fn_temp_chart_04", "fn_knock_chart_04", "fn_last_alert_04"]]
  },
  {
    "id": "gauge_temp_04",
    "type": "ui_gauge",
    "z": "tab_flow04",
    "name": "Temperature",
    "group": "grp_sensor_04",
    "order": 1,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Temperature",
    "label": "°C",
    "format": "{{value}}°C",
    "min": "15",
    "max": "40",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "25",
    "seg2": "30",
    "x": 530,
    "y": 80,
    "wires": []
  },
  {
    "id": "txt_status_04",
    "type": "ui_text",
    "z": "tab_flow04",
    "name": "Alert Status",
    "group": "grp_sensor_04",
    "order": 2,
    "width": 6,
    "height": 2,
    "format": "<span style='font-size:22px;font-weight:bold'>{{msg.status}}</span>",
    "label": "Status",
    "x": 530,
    "y": 140,
    "wires": []
  },
  {
    "id": "txt_knock_04",
    "type": "ui_text",
    "z": "tab_flow04",
    "name": "Knock Count",
    "group": "grp_sensor_04",
    "order": 3,
    "width": 6,
    "height": 2,
    "format": "<span style='font-size:22px'>{{msg.knock}}</span>",
    "label": "Knock Count",
    "x": 530,
    "y": 200,
    "wires": []
  },
  {
    "id": "fn_last_alert_04",
    "type": "function",
    "z": "tab_flow04",
    "name": "Track Last Alert",
    "func": "if (msg.status === 'WARNING' || msg.status === 'CRITICAL') {\n  var now = new Date();\n  var ts  = now.toLocaleTimeString();\n  flow.set('lastAlert', msg.status + ' at ' + ts + ' (' + msg.temp.toFixed(1) + '°C)');\n}\nvar la = flow.get('lastAlert') || 'None';\nmsg.payload = la;\nreturn msg;",
    "outputs": 1,
    "x": 530,
    "y": 260,
    "wires": [["txt_last_alert_04"]]
  },
  {
    "id": "txt_last_alert_04",
    "type": "ui_text",
    "z": "tab_flow04",
    "name": "Last Alert",
    "group": "grp_sensor_04",
    "order": 4,
    "width": 6,
    "height": 2,
    "format": "{{msg.payload}}",
    "label": "Last Alert",
    "x": 760,
    "y": 260,
    "wires": []
  },
  {
    "id": "fn_temp_chart_04",
    "type": "function",
    "z": "tab_flow04",
    "name": "Prep Temp Chart",
    "func": "msg.payload = msg.temp;\nmsg.topic   = \"Temperature (°C)\";\nmsg.x       = Date.now();\nreturn msg;",
    "outputs": 1,
    "x": 530,
    "y": 360,
    "wires": [["chart_temp_04"]]
  },
  {
    "id": "chart_temp_04",
    "type": "ui_chart",
    "z": "tab_flow04",
    "name": "Temp History",
    "group": "grp_charts_04",
    "order": 1,
    "width": 12,
    "height": 6,
    "label": "Temperature History",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Waiting for data...",
    "dot": false,
    "ymin": "15",
    "ymax": "40",
    "removeOlder": "5",
    "removeOlderUnit": "60",
    "cutout": 0,
    "x": 760,
    "y": 360,
    "wires": [[], []]
  },
  {
    "id": "fn_knock_chart_04",
    "type": "function",
    "z": "tab_flow04",
    "name": "Prep Knock Chart",
    "func": "msg.payload = msg.knock;\nmsg.topic   = \"Knock Count\";\nmsg.x       = Date.now();\nreturn msg;",
    "outputs": 1,
    "x": 530,
    "y": 460,
    "wires": [["chart_knock_04"]]
  },
  {
    "id": "chart_knock_04",
    "type": "ui_chart",
    "z": "tab_flow04",
    "name": "Knock History",
    "group": "grp_charts_04",
    "order": 2,
    "width": 12,
    "height": 4,
    "label": "Knock History",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "step-after",
    "nodata": "Waiting for data...",
    "dot": true,
    "ymin": "0",
    "ymax": "10",
    "removeOlder": "5",
    "removeOlderUnit": "60",
    "cutout": 0,
    "x": 760,
    "y": 460,
    "wires": [[], []]
  },
  {
    "id": "sl_warn_04",
    "type": "ui_slider",
    "z": "tab_flow04",
    "name": "Warning Threshold",
    "label": "Warning Threshold (°C)",
    "tooltip": "",
    "group": "grp_ctrl_04",
    "order": 1,
    "width": 10,
    "height": 2,
    "passthru": true,
    "outs": "all",
    "topic": "warn",
    "topicType": "str",
    "min": 20,
    "max": 35,
    "step": 1,
    "x": 200,
    "y": 580,
    "wires": [["fn_build_cmd_04", "txt_warn_val_04"]]
  },
  {
    "id": "txt_warn_val_04",
    "type": "ui_text",
    "z": "tab_flow04",
    "name": "Warn Value",
    "group": "grp_ctrl_04",
    "order": 2,
    "width": 2,
    "height": 2,
    "format": "<span style='font-size:24px;color:#ffc107;font-weight:bold'>{{msg.payload}}°</span>",
    "label": "",
    "x": 470,
    "y": 580,
    "wires": []
  },
  {
    "id": "sl_crit_04",
    "type": "ui_slider",
    "z": "tab_flow04",
    "name": "Critical Threshold",
    "label": "Critical Threshold (°C)",
    "tooltip": "",
    "group": "grp_ctrl_04",
    "order": 3,
    "width": 10,
    "height": 2,
    "passthru": true,
    "outs": "all",
    "topic": "crit",
    "topicType": "str",
    "min": 20,
    "max": 35,
    "step": 1,
    "x": 200,
    "y": 640,
    "wires": [["fn_build_cmd_04", "txt_crit_val_04"]]
  },
  {
    "id": "txt_crit_val_04",
    "type": "ui_text",
    "z": "tab_flow04",
    "name": "Crit Value",
    "group": "grp_ctrl_04",
    "order": 4,
    "width": 2,
    "height": 2,
    "format": "<span style='font-size:24px;color:#dc3545;font-weight:bold'>{{msg.payload}}°</span>",
    "label": "",
    "x": 470,
    "y": 640,
    "wires": []
  },
  {
    "id": "sw_mute_04",
    "type": "ui_switch",
    "z": "tab_flow04",
    "name": "Mute Buzzer",
    "label": "Mute Buzzer",
    "tooltip": "",
    "group": "grp_ctrl_04",
    "order": 5,
    "width": 4,
    "height": 2,
    "passthru": true,
    "topic": "mute",
    "topicType": "str",
    "style": "",
    "onvalue": "1",
    "onvalueType": "str",
    "offvalue": "0",
    "offvalueType": "str",
    "oncolor": "#e81415",
    "offcolor": "",
    "onicon": "fa-bell-slash",
    "officon": "fa-bell",
    "x": 200,
    "y": 700,
    "wires": [["fn_build_cmd_04"]]
  },
  {
    "id": "btn_warn_04",
    "type": "ui_button",
    "z": "tab_flow04",
    "name": "Test WARNING",
    "group": "grp_ctrl_04",
    "order": 6,
    "width": 4,
    "height": 2,
    "passthru": false,
    "label": "Test WARNING",
    "tooltip": "Trigger a 5-second WARNING alert on the ESP32",
    "color": "",
    "bgcolor": "#ffc107",
    "icon": "",
    "payload": "CMD:ALERT:WARNING",
    "payloadType": "str",
    "topic": "",
    "topicType": "str",
    "x": 200,
    "y": 760,
    "wires": [["mqtt_cmd_out_04"]]
  },
  {
    "id": "btn_crit_04",
    "type": "ui_button",
    "z": "tab_flow04",
    "name": "Test CRITICAL",
    "group": "grp_ctrl_04",
    "order": 7,
    "width": 4,
