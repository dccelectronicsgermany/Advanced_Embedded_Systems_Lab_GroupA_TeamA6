    "wires": [["mqtt_cmd_out_04"]]
  },
  {
    "id": "fn_build_cmd_04",
    "type": "function",
    "z": "tab_flow04",
    "name": "Build Command",
    "func": "var t = msg.topic;\nif (t === 'warn') {\n  msg.payload = 'CMD:WARN:' + Math.round(msg.payload);\n} else if (t === 'crit') {\n  msg.payload = 'CMD:CRIT:' + Math.round(msg.payload);\n} else if (t === 'mute') {\n  msg.payload = 'CMD:MUTE:' + msg.payload;\n} else {\n  return null;\n}\nreturn msg;",
    "outputs": 1,
    "x": 470,
    "y": 700,
    "wires": [["mqtt_cmd_out_04"]]
  },
  {
    "id": "mqtt_cmd_out_04",
    "type": "mqtt out",
    "z": "tab_flow04",
    "name": "MQTT Command Out",
    "topic": "sensors/node01/cmd",
    "qos": "0",
    "retain": "false",
    "broker": "mqtt_broker_04",
    "x": 720,
    "y": 700,
    "wires": []
  },
  {
    "id": "grp_sensor_04",
    "type": "ui_group",
