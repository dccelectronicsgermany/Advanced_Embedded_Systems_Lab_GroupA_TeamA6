[
  {
    "id": "tab_flow02",
    "type": "tab",
    "label": "Flow 02 – Basic Dashboard",
    "disabled": false,
    "info": "Step 2: Parse MQTT packets and show temperature gauge, alert status, and knock count on the dashboard."
  },
  {
    "id": "mqtt_in_02",
    "type": "mqtt in",
    "z": "tab_flow02",
    "name": "MQTT In",
    "topic": "sensors/node01",
    "qos": "0",
    "datatype": "utf8",
    "broker": "mqtt_broker_02",
    "x": 120,
    "y": 160,
    "wires": [["fn_parse_02"]]
  },
  {
    "id": "fn_parse_02",
    "type": "function",
    "z": "tab_flow02",
    "name": "Parse Packet",
    "func": "var parts = msg.payload.split(';');\nvar obj = {};\nparts.forEach(function(p) {\n  var kv = p.split(':');\n  if (kv.length === 2) obj[kv[0].toLowerCase()] = kv[1];\n});\nmsg.temp   = parseFloat(obj.temp)   || 0;\nmsg.knock  = parseInt(obj.knock)    || 0;\nmsg.status = obj.status             || 'UNKNOWN';\nmsg.mute   = obj.mute === '1';\nmsg.warn   = parseFloat(obj.warn)   || 25;\nmsg.crit   = parseFloat(obj.crit)   || 30;\nreturn msg;",
    "outputs": 1,
    "x": 310,
    "y": 160,
    "wires": [["gauge_temp_02", "txt_status_02", "txt_knock_02"]]
  },
  {
    "id": "gauge_temp_02",
    "type": "ui_gauge",
    "z": "tab_flow02",
    "name": "Temperature",
    "group": "grp_sensor_02",
    "order": 1,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Temperature",
    "label": "°C",
    "format": "{{value}}°C",
    "min": "15",
    "max": "40",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "25",
    "seg2": "30",
    "x": 530,
    "y": 100,
    "wires": []
  },
  {
    "id": "txt_status_02",
    "type": "ui_text",
    "z": "tab_flow02",
    "name": "Alert Status",
    "group": "grp_sensor_02",
    "order": 2,
    "width": 6,
    "height": 2,
    "format": "<span style='font-size:22px;font-weight:bold'>{{msg.status}}</span>",
    "label": "Status",
    "x": 530,
    "y": 160,
    "wires": []
  },
  {
    "id": "txt_knock_02",
    "type": "ui_text",
    "z": "tab_flow02",
    "name": "Knock Count",
    "group": "grp_sensor_02",
    "order": 3,
    "width": 6,
    "height": 2,
    "format": "<span style='font-size:22px'>{{msg.knock}}</span>",
    "label": "Knock Count",
    "x": 530,
    "y": 220,
    "wires": []
  },
  {
    "id": "grp_sensor_02",
    "type": "ui_group",
    "name": "Sensor Data",
    "tab": "ui_tab_02",
    "order": 1,
    "disp": true,
    "width": "6"
  },
  {
    "id": "ui_tab_02",
    "type": "ui_tab",
    "name": "Sensor Monitor",
    "icon": "dashboard",
    "order": 1,
    "disabled": false,
    "hidden": false
  },
  {
    "id": "mqtt_broker_02",
    "type": "mqtt-broker",
    "name": "Local Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "nodered_flow02",
    "usetls": false,
    "compatmode": false,
    "keepalive": "60",
    "cleansession": true
  }
]
